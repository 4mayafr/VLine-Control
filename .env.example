# ---------------------------------------------------------------------------
# V/LINE CONTROL — environment configuration
# Copy to .env.local (local) or set these in your hosting provider's dashboard.
# Never commit real values.
# ---------------------------------------------------------------------------

# Session signing secret. Required in production.
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# SQLite database file used by the Node runtime data layer.
# Defaults to ./data/vline.db. Use a persistent volume if self-hosting.
DATABASE_FILE=./data/vline.db

# Inbound V/LINE Inform email ingestion endpoint (/api/inform/ingest).
# INFORM_INGEST_TOKEN is checked as an "Authorization: Bearer <token>" header,
# or as a ?token= query parameter for mail providers that cannot set headers.
INFORM_INGEST_ENABLED=false
INFORM_INGEST_TOKEN=

# ---------------------------------------------------------------------------
# Optional Supabase / Postgres target.
# The schema is Postgres-compatible (see supabase/migrations/0001_init.sql).
# The app boots on SQLite so it runs with zero external services; see README
# for the migration path to a hosted Postgres instance.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=
